# Zkopírujte tento soubor do skutečného nastavení proměnných prostředí
# na Vercelu (Project Settings -> Environment Variables). Tento soubor
# samotný se NIKDY necommitujte s reálnými hodnotami do Gitu.

# Heslo do administrace. Nastavte si ho přímo tady jako obyčejný text -
# kdykoliv si ho ve Vercelu sami změníte, není potřeba nic přepočítávat.
ADMIN_PASSWORD=

# Náhodný dlouhý řetězec (min. 32 znaků) pro podepisování session cookies.
# Vygenerujte např.: openssl rand -hex 32
SESSION_SECRET=

# Domény, ze kterých smí administrace volat API (bez lomítka na konci).
# Více domén oddělte čárkou.
ALLOWED_ORIGIN=https://tesarstvi-suta.cz

# GitHub token (fine-grained, jen "Contents: read and write" pro tento repozitář)
GITHUB_TOKEN=
GITHUB_REPO=uzivatel/tesarstvi-suta
GITHUB_BRANCH=main
